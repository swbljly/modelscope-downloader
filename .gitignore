# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# ---- 隔离打包环境（约 182 MB，绝不入库）----
pack/.venv/

# ---- PyInstaller 构建中间产物 ----
pack/build/
pack/dist/
*.toc
*.pyz
*.pkg

# ---- 二进制交付物：32.7 MB 的 exe 走 GitHub Release，不入库 ----
dist/*.exe
*.exe

# ---- build.py 运行时生成的图标（纯标准库绘制，可随时重建）----
pack/app.ico

